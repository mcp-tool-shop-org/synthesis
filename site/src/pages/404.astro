---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../site-config';

// Paired with disable404Route: true. GitHub Pages serves dist/404.html for
// unmatched URLs, so hrefs must be BASE_URL-prefixed (relative links resolve
// against the missing path).
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title={`Page not found — ${config.title}`}
  description="That URL does not exist on the Synthesis site. Head back to the home page or open the handbook."
  logoBadge={config.logoBadge}
  brandName={config.brandName}
  repoUrl={config.repoUrl}
  npmUrl={config.npmUrl}
  footerText={config.footerText}
  nav={config.sections.map((s) => ({ href: `${base}#${s.id}`, label: s.title }))}
>
  <section
    style="max-width: 720px; margin: 96px auto 144px; padding: 0 24px; text-align: center;"
  >
    <p
      style="color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.12em; font-size: 12px; margin: 0 0 12px;"
    >
      404 — page not found
    </p>
    <h1
      style="font-size: clamp(32px, 5vw, 48px); font-weight: 500; line-height: 1.1; margin: 0 0 16px;"
    >
      That URL isn’t here.
    </h1>
    <p
      style="color: var(--color-muted); font-size: 18px; line-height: 1.5; margin: 0 0 32px;"
    >
      The page you tried to open doesn’t exist on this site (or moved). The
      handbook covers installation, checkers, test cases, and CI — that’s the
      most likely place to find what you came for.
    </p>
    <div
      style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;"
    >
      <a
        href={base}
        style="display: inline-block; padding: 12px 24px; border-radius: 8px; background: var(--color-accent); color: var(--color-surface); font-weight: 500; text-decoration: none;"
      >
        Back to home
      </a>
      <a
        href={`${base}handbook/`}
        style="display: inline-block; padding: 12px 24px; border-radius: 8px; border: 1px solid var(--color-edge); color: var(--color-heading); text-decoration: none;"
      >
        Open the handbook
      </a>
    </div>
    <p
      style="color: var(--color-muted); font-size: 13px; margin: 48px 0 0; line-height: 1.6;"
    >
      Still missing something?{' '}
      <a
        href={`${config.repoUrl}/issues/new`}
        style="color: var(--color-heading); text-decoration: underline;"
      >
        Open an issue on GitHub
      </a>
      {' '}— link the URL you came from and we’ll fix the redirect.
    </p>
  </section>
</BaseLayout>
